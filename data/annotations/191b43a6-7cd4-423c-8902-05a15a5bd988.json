      "end_time": 6000,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "En 1947 García Márquez se traslada a Bogotá para estudiar derecho, pero descubre una pasión: el periodismo "
            }
          ]
        },
        {
          "type": "paragraph",
          "children": [
            {
              "text": "\n\n\n"
            }
          ]
        }
      ],
