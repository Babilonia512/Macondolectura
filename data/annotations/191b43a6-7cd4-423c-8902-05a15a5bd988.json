    },
    {
      "start_time": 3480,
      "end_time": 3600,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "Aracataca, pueblo de la costa colombiana, Departamento de Magdalena. Datos biográficos "
            }
          ]
        },
        {
          "type": "paragraph",
          "children": [
            {
              "text": "\n\n\n"
            }
          ]
        }
      ],
      "tags": [
