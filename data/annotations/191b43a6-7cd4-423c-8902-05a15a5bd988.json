{
  "annotations": [
    {
      "start_time": 600,
      "end_time": 1500,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "“Yo escribo para que me quieran más” García Márquez en una entrevista habla de su motivación personal para escribir. Su poética parece referirse a una visión personal de la escritura como puente de amistad"
            }
          ]
        },
        {
          "type": "paragraph",
          "children": [
            {
              "text": "\n\n\n"
            }
          ]
        }
      ],
