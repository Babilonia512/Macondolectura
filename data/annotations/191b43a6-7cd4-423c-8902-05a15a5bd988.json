    },
    {
      "start_time": 6000,
      "end_time": 6300,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "El Espectador. Este periódico marca el inicio de su informal carrera periodística"
            }
          ]
        },
        {
          "type": "paragraph",
          "children": [
            {
              "text": "\n\n\n"
            }
          ]
        }
      ],
      "tags": [
